# ==============================================================================
# LIVETVMARKET - High Performance, Routing & Security Configuration (.htaccess)
# ==============================================================================

DirectoryIndex index.php index.html

# Beautiful Custom 404 Handler for all invalid routes
ErrorDocument 404 /404.php

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect .html to .php if requested
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1.php [R=301,L]

    # Dynamic SEO, Sitemap, Robots & LLM AI specifications
    RewriteRule ^sitemap\.xml$ sitemap.php [NC,L]
    RewriteRule ^robots\.txt$ robots.php [NC,L]
    RewriteRule ^llms-full\.txt$ llms.php?full=1 [QSA,NC,L]
    RewriteRule ^llms\.txt$ llms.php [NC,L]

    # Specific clean route for blog listing
    RewriteRule ^blog/?$ blog.php [NC,L]

    # Specific clean route for blog articles: /blog/<slug> -> blog-details.php?slug=<slug>
    RewriteRule ^blog/([^/]+)/?$ blog-details.php?slug=$1 [QSA,NC,L]

    # Digital Store clean routes: /product/<slug> -> product.php?slug=<slug>
    RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [QSA,NC,L]
    RewriteRule ^store/?$ shop.php?tab=store [QSA,NC,L]

    # Specific alias for refund policy
    RewriteRule ^refund/?$ refund-policy.php [NC,L]

    # Clean URLs: allow /channels to serve channels.php, /contact to serve contact.php, etc.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# Browser Caching & Compression for Blazing Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
